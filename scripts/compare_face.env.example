# Copy to scripts/compare_face.env (gitignored) and fill in secrets.
# Never commit real keys. The agent can run compare against this local file.

# Janus instance under test (include public base_path if any, no trailing slash)
JANUS_COMPARE_URL=https://example.com/janus2
JANUS_PUBLIC_FACE=koios
# Optional: API key Janus expects on the public face
# JANUS_FACE_API_KEY=

# Native providers (ground truth for the chosen face)
KOIOS_BASE_URL=https://api.koios.rest/api/v1
KOIOS_API_KEY=

BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=

# Fixtures: use a real mainnet/preprod pool bech32 that has history
COMPARE_POOL_ID=pool1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq

# Pin a completed epoch for apple-to-apple epoch_info / pool_history compares.
# If unset, the harness uses native tip.epoch_no - 1 for Koios.
# COMPARE_EPOCH=640

# Optional comma-separated epochs for pool_history filter (overrides COMPARE_EPOCH).
# Use recent epochs; old ones may be outside the first BF/Janus history page.
# COMPARE_EPOCHS=644,643,642
