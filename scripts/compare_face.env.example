# Copy to scripts/compare_face.env (gitignored via *.env patterns / local .env)
# and fill in secrets. Never commit real keys.

# Janus instance under test (include public base_path if any, no trailing slash)
JANUS_COMPARE_URL=https://example.com/janus2
JANUS_PUBLIC_FACE=koios
# Optional: API key Janus expects on the public face
# JANUS_FACE_API_KEY=

# Native providers (ground truth for the chosen face)
KOIOS_BASE_URL=https://api.koios.rest/api/v1
KOIOS_API_KEY=

BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=

# Fixtures (use a real mainnet/preprod pool bech32)
COMPARE_POOL_ID=pool1qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
# Optional comma-separated epochs for pool_history filter after fetch
# COMPARE_EPOCHS=500,501,502
