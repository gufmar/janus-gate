# Copy to .env (or systemd EnvironmentFile) and fill in secrets.
# Do not commit real keys.

JANUS_BACKEND_API_KEY=
# Optional overrides:
# JANUS_PUBLIC_FACE=blockfrost
# JANUS_BACKEND_PROVIDER=koios
# JANUS_BACKEND_BASE_URL=https://api.koios.rest/api/v1
# JANUS_HOST=0.0.0.0
# JANUS_PORT=8080
# JANUS_BASE_PATH=/janus
# Sets auth.fallback_backend_key (and legacy backend.api_key):
# JANUS_BACKEND_API_KEY=
